FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
# Force gpiozero to use the lgpio pin factory
ENV GPIOZERO_PIN_FACTORY=lgpio

# 1. Setup Raspberry Pi Repos (Bypassing SHA-1 validation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
 && curl -fsSL https://archive.raspberrypi.com/debian/raspberrypi.gpg.key \
    | gpg --dearmor -o /usr/share/keyrings/raspberrypi.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/raspberrypi.gpg trusted=yes] https://archive.raspberrypi.com/debian/ trixie main" \
    > /etc/apt/sources.list.d/raspberrypi.list \
 && apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-gpiozero \
    python3-lgpio \
    python3-setuptools \
    i2c-tools \
    python3-smbus \
    libglib2.0-0 \
    libstdc++6 \
    build-essential \
    git \
    iputils-ping \
 && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 2. Python virtual environment
# ------------------------------------------------------------

# Allow the venv to use Debian-installed packages such as
# gpiozero and lgpio.
RUN python3 -m venv --system-site-packages /opt/venv

# Make the virtual environment the default Python environment
ENV PATH="/opt/venv/bin:/root/.local/bin:/usr/bin:${PATH}"

# ------------------------------------------------------------
# 3. Install Python application packages
# ------------------------------------------------------------
RUN python -m pip install --upgrade pip setuptools wheel \
 && python -m pip install --no-cache-dir \
    evdev \
    numpy \
    opencv-python-headless \
    flask \
    debugpy \
    ovos-bus-client \
    ledshim \
    icm20948 \
    vpython \
    git+https://github.com/orionrobots/Raspi_MotorHAT

# Ensure directory exists for ARM-specific libraries if needed
RUN mkdir -p /usr/lib/aarch64-linux-gnu

WORKDIR /app
COPY test/ /app/test/
COPY app/ /app/

EXPOSE 5000 5678

CMD ["python3", "control_server.py"]