FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

USER root

# Create the ovos user and group first so ownership flags work properly
RUN groupadd -g 1000 ovos && \
    useradd -m -u 1000 -g ovos -G audio -s /bin/bash ovos && \
    mkdir -p /home/ovos && \
    chown -R ovos:ovos /home/ovos

# Install system dependencies including python3-venv
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        python3-espeak \
        python3-setuptools \
        build-essential \
        espeak-ng \
        libportaudio2 \
        alsa-utils  \
        iputils-ping \
        curl \
        nano && \
    rm -rf /var/lib/apt/lists/*

# Create the virtual environment and assign ownership to the ovos user
RUN python3 -m venv /home/ovos/venv && \
    chown -R ovos:ovos /home/ovos/venv

# Activate the virtual environment by updating PATH
ENV VIRTUAL_ENV="/home/ovos/venv"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy local model files with correct ownership
COPY --chown=ovos:ovos phoonnx_test_manager.py /home/ovos/phoonnx_test_manager.py
COPY --chown=ovos:ovos phoonnx_test_localmodel.py /home/ovos/phoonnx_test_localmodel.py
COPY --chown=ovos:ovos phoonnx_test_localmodel_stream.py /home/ovos/phoonnx_test_localmodel_stream.py
COPY --chown=ovos:ovos phoonnx_test_localmodel_html.py /home/ovos/phoonnx_test_localmodel_html.py
COPY --chown=ovos:ovos phoonnx_test_localmodel_voices.py /home/ovos/phoonnx_test_localmodel_voices.py
COPY --chown=ovos:ovos phoonnx_test_localmodel_krokoro.py /home/ovos/phoonnx_test_localmodel_krokoro.py

COPY --chown=ovos:ovos phoonnx_voice_server.py /home/ovos/phoonnx_voice_server.py
COPY --chown=ovos:ovos german_normalizer.py /home/ovos/german_normalizer.py 


# Install Python dependencies inside the virtual environment
# (--break-system-packages is no longer needed since we are using a venv)
RUN pip install --no-cache-dir \
    phoonnx[de] \
    flask \
    onnxruntime \
    ovos-plugin-manager \
    sounddevice \
    soundfile \
    gruut[de] \
    scipy \
    num2words \
    kokoro-onnx

# Pre-fill the voice index cache using the venv binaries
RUN phoonnx-voices update-cache || true
RUN phoonnx-voices list || true

WORKDIR /home/ovos

# Drop down to non-root user for execution security
USER ovos

# Run your test script using the virtual environment python
CMD ["python", "/home/ovos/phoonnx_voice_server.py"]