FROM smartgic/ovos-audio:testing

USER root

RUN mkdir -p \
    /home/ovos/sound-server \
    /home/ovos/.local/share/mycroft/sounds && \
    chown -R ovos:ovos \
    /home/ovos/sound-server \
    /home/ovos/.local/share/mycroft/sounds

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-espeak \
        espeak-ng && \
    rm -rf /var/lib/apt/lists/*

COPY --chown=ovos:ovos ./sound-server/ \
    /home/ovos/sound-server/

COPY --chown=ovos:ovos ./sound/ \
    /home/ovos/.local/share/mycroft/sounds/

USER ovos

RUN . ~/.venv/bin/activate && \
    pip install --no-cache-dir \
    ovos-tts-plugin-piper \
    ovos-plugin-manager
    
