FROM smartgic/ovos-audio:latest

USER root

RUN mkdir -p \
    /home/ovos/sound-server \
    /home/ovos/.local/share/piper_tts \
    /home/ovos/.local/share/mycroft/sounds \
    /home/ovos/model/phoonnx \
    /home/ovos/.cache/ovos_gui && \
    chown -R ovos:ovos \
    /home/ovos/sound-server \
    /home/ovos/.local/share/piper_tts \
    /home/ovos/.local/share/mycroft/sounds \
    /home/ovos/model/phoonnx \
    /home/ovos/.cache/ovos_gui

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3-espeak \
        espeak-ng && \
    rm -rf /var/lib/apt/lists/*

#RUN . ~/.venv/bin/activate && \
#    pip install --no-cache-dir --upgrade phoonnx ovos-tts-plugin-phoonnx ovos-plugin-manager

COPY --chown=ovos:ovos ./sound-server/  /home/ovos/sound-server/

COPY --chown=ovos:ovos ./sound/ /home/ovos/.local/share/mycroft/sounds/

#COPY --chown=ovos:ovos ./models/phoonnx/ /home/ovos/model/phoonnx/

# default cache ~/.cache/huggingface/hub/ by default
# Pre-fill the voice index cache

#RUN phoonnx-voices update-cache || true
#RUN phoonnx-voices list || true
## OpenVoiceOS/pipertts_de-DE_miro
##RUN phoonnx-voices download OpenVoiceOS/pipertts_de-DE_miro
COPY --chown=ovos:ovos ./models/phoonnx/miro_de-DE.onnx /home/ovos/miro_de-DE.onnx
COPY --chown=ovos:ovos ./models/phoonnx/miro_de-DE.onnx.json /home/ovos/miro_de-DE.onnx.json

RUN chown -R ovos:ovos /home/ovos/.cache

USER ovos

RUN . ~/.venv/bin/activate && \
    pip install --no-cache-dir --break-system-packages \
    ovos-tts-server \
    #phoonnx \
    #onnxruntime \
    ovos-tts-plugin-piper \
    ovos-plugin-manager


# 1. Sicherstellen, dass das Verzeichnis existiert
#RUN mkdir -p /home/ovos/.cache/phoonnx



